# Copy this file to .env and fill in real values. .env itself is
# gitignored — never commit it.

# Port the app listens on locally. Optional, defaults to 3000.
PORT=3000

# Subpath the whole app is mounted under. Use / (or leave unset) for
# local development. Production is served at /content-checker.
BASE_PATH=/

# Random secret used to sign the session cookie. Required — the app
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt hash of the single shared team password. Required — the app
# refuses to start without it. The plaintext password is never stored
# anywhere. Generate a hash with:
#   npm run hash-password -- 'your-team-password'
TEAM_PASSWORD_HASH=

# 64-character hex string (32 bytes), the AES-256-GCM key project staging
# credentials are encrypted with at rest. Required — the app refuses to
# start without it, or if it isn't exactly 32 bytes of valid hex. Generate
# one with:
#   npm run generate-encryption-key
ENCRYPTION_KEY=

# Optional. A secret sent as the X-ContentCheck-Token header on every
# outbound request this tool makes, so a client's CDN/WAF (Cloudflare and
# similar) can allow this tool through a bot challenge with a rule that
# actually can't be spoofed by copying a User-Agent string — see
# docs/cdn-allow-rule.md for the rule to add on the client's side. Leave
# unset for local development against sites with no such challenge; the
# app starts normally and logs that outbound identification isn't
# configured. When set, must be at least 32 characters or the app refuses
# to start. Generate one with:
#   npm run generate-outbound-token
CONTENTCHECK_OUTBOUND_TOKEN=
